msgid "Wysyłka"
msgstr "Newsletter"

msgid "Grupy Test nie można usunąć. Wyłącz ją w Konfiguracja → Utwórz grupę do testowania."
msgstr "The Test group cannot be deleted. Disable it in Configuration → Create a group for testing."

msgid "Nie znaleziono grupy."
msgstr "Group not found."

msgid "Nie znaleziono użytkownika o podanym ID."
msgstr "No user found with the given ID."

msgid "Ten użytkownik już jest w grupie."
msgstr "This user is already in the group."

msgid "Wybierz użytkownika z listy."
msgstr "Select a user from the list."

msgid "Użytkownik już należy do wybranych grup."
msgstr "The user already belongs to the selected groups."

msgid "Wybierz grupę."
msgstr "Select a group."

msgid "Nie udało się wgrać pliku."
msgstr "Failed to upload the file."

msgid "Plik jest za duży (maksymalnie 2 MB)."
msgstr "The file is too large (maximum 2 MB)."

msgid "Dozwolone są tylko pliki .csv i .txt."
msgstr "Only .csv and .txt files are allowed."

msgid "Zakończono import członków z pliku CSV."
msgstr "Member import from the CSV file completed."

msgid "zaimportował z CSV do %1$s: dodano %2$d"
msgstr "imported from CSV into %1$s: added %2$d"

msgid "Brak uprawnień do tego głosowania."
msgstr "You do not have permission for this poll."

msgid "usunął wysyłkę %s"
msgstr "deleted newsletter %s"

msgid "Brak uprawnień do tego ekranu."
msgstr "You do not have permission for this screen."

msgid "Pominięto %d pozycję (trwające głosowanie lub brak uprawnień). Trwające głosowanie trzeba najpierw zakończyć."
msgid_plural "Pominięto %d pozycji (trwające głosowania lub brak uprawnień). Trwające głosowania trzeba najpierw zakończyć."
msgstr[0] "Skipped %d item (poll in progress or insufficient permissions). A poll in progress must be ended first."
msgstr[1] "Skipped %d items (polls in progress or insufficient permissions). Polls in progress must be ended first."

msgid "Głosowanie wystartowało."
msgstr "The poll has started."

msgid "Szkic zapisany, ale niektóre pytania mają mniej niż 3 odpowiedzi. Uzupełnij je przed startem (min. 2 własne odpowiedzi + „Wstrzymuję się”)."
msgstr "Draft saved, but some questions have fewer than 3 answers. Complete them before starting (min. 2 own answers + “Abstain”)."

msgid "Zamknij"
msgstr "Close"

msgid "Głosowania:"
msgstr "Polls:"

msgid "Maksymalnie %d pytań."
msgstr "Maximum %d questions."

msgid "Maksymalnie %d odpowiedzi na pytanie."
msgstr "Maximum %d answers per question."

msgid "Pytanie musi mieć co najmniej dwie własne odpowiedzi plus „Wstrzymuję się”."
msgstr "A question must have at least two own answers plus “Abstain”."

msgid "Usuń pytanie"
msgstr "Remove question"

msgid "Usuń odpowiedź"
msgstr "Remove answer"

msgid "Załaduj więcej (pokazano %1$d z %2$d)"
msgstr "Load more (showing %1$d of %2$d)"

msgid "Aby wystartować, uzupełnij: "
msgstr "To start, complete: "

msgid "tytuł"
msgstr "title"

msgid "czas trwania"
msgstr "duration"

msgid "grupę docelową"
msgstr "target group"

msgid "treść pytania"
msgstr "question text"

msgid "min. 3 odpowiedzi w pytaniu %d"
msgstr "min. 3 answers in question %d"

msgid "treść %d. odpowiedzi w pytaniu %d"
msgstr "text of answer %d in question %d"

msgid "powtórzona odpowiedź w pytaniu %d"
msgstr "duplicate answer in question %d"

msgid "Treść pola (np. Imię i nazwisko kandydata)"
msgstr "Field text (e.g. candidate's full name)"

msgid "Nowy termin zakończenia musi być w przyszłości. Wybierz dłuższy czas trwania albo użyj „Zakończ”."
msgstr "The new end date must be in the future. Choose a longer duration or use “End”."

msgid "zmienił czas trwania głosowania %s"
msgstr "changed the duration of poll %s"

msgid "Czas trwania można zmienić tylko dla trwającego głosowania."
msgstr "Duration can only be changed for a poll in progress."

msgid "Szkic %s"
msgstr "Draft %s"

msgid "Każda odpowiedź może zawierać maksymalnie 512 znaków."
msgstr "Each answer may contain at most 512 characters."

msgid "Odpowiedzi w pytaniu „%s” nie mogą się powtarzać."
msgstr "Answers in question “%s” must not repeat."

msgid "Każde pytanie: min. 2 własne odpowiedzi + „Wstrzymuję się” (razem 3–12)."
msgstr "Each question: min. 2 own answers + “Abstain” (3–12 in total)."

msgid "Maksymalnie 12 odpowiedzi na pytanie."
msgstr "Maximum 12 answers per question."

msgid "Wybierz co najmniej jedną ze swoich grup docelowych."
msgstr "Select at least one of your target groups."

msgid "Tylko administrator może usuwać głosowania."
msgstr "Only an administrator can delete polls."

msgid "Trwającego głosowania nie można usunąć. Najpierw je zakończ."
msgstr "A poll in progress cannot be deleted. End it first."

msgid "Nie wybrano użytkownika."
msgstr "No user selected."

msgid "WordPress (PHP-mail) jest niedostępne przy ponad 250 adresach e-mail w systemie. Zachowano poprzednią metodę."
msgstr "WordPress (PHP mail) is unavailable with more than 250 e-mail addresses in the system. The previous method was kept."

msgid "Zapisano domyślną treść."
msgstr "Default content saved."

msgid "Trwającej ankiety nie można usunąć. Najpierw ją zakończ."
msgstr "A survey in progress cannot be deleted. End it first."

msgid "Nie można edytować ankiety, która została rozpoczęta lub zakończona."
msgstr "A survey that has been started or ended cannot be edited."

msgid "Ta ankieta ma już zgłoszenia — nie można zmieniać jej pól."
msgstr "This survey already has submissions — its fields cannot be changed."

msgid "Pole %d jest puste — wpisz treść lub usuń je."
msgstr "Field %d is empty — enter text or remove it."

msgid "Treść pola może zawierać maksymalnie 512 znaków."
msgstr "Field text may contain at most 512 characters."

msgid "Czy na pewno chcesz usunąć tę wiadomość?"
msgstr "Are you sure you want to delete this message?"

msgid "Wyślij"
msgstr "Send"

msgid "Trwa"
msgstr "In progress"

msgid "Oddane głosy / uprawnieni"
msgstr "Votes cast / eligible"

msgid "Termin zakończenia minął. Kliknij „Zakończ”, aby formalnie zamknąć głosowanie."
msgstr "The end date has passed. Click “End” to formally close the poll."

msgid "Brak uprawnień do usuwania głosowań."
msgstr "You do not have permission to delete polls."

msgid "Usunąć zaznaczone głosowania (%d) wraz z oddanymi głosami? Operacja jest nieodwracalna. Trwające głosowania zostaną pominięte."
msgstr "Delete the selected polls (%d) together with the votes cast? This cannot be undone. Polls in progress will be skipped."

msgid "Zakończyć zaznaczone głosowania (%d)? Przyjmowanie głosów zostanie zatrzymane. Operacja nieodwracalna."
msgstr "End the selected polls (%d)? Accepting votes will be stopped. This cannot be undone."

msgid "Zakończona"
msgstr "Ended"

msgid "Usunąć zaznaczone ankiety (%d) wraz ze wszystkimi zgłoszeniami? Operacja jest nieodwracalna. Trwające ankiety zostaną pominięte."
msgstr "Delete the selected surveys (%d) together with all submissions? This cannot be undone. Surveys in progress will be skipped."

msgid "Zakończyć zaznaczone ankiety (%d)? Operacja nieodwracalna."
msgstr "End the selected surveys (%d)? This cannot be undone."

msgid "OpenVote"
msgstr "OpenVote"

msgid "Wtyczka do przeprowadzania elektronicznych głosowań i ankiet w organizacji. Głosowania wielopytaniowe z grupami docelowymi i rolą Koordynatora. Zaproszenia e-mail oraz masowa wysyłka wiadomości (Wysyłka) — WordPress, SMTP, SendGrid, Brevo, Freshmail, GetResponse. Głosowanie bez logowania z kodem potwierdzającym wysłanym na e-mail. Ankiety ze stroną zgłoszeń. Wyniki jawne lub anonimowe, eksport do PDF."
msgstr "A plugin for conducting electronic polls and surveys in an organization. Multi-question polls with target groups and the Coordinator role. E-mail invitations and mass message sending (Newsletter) — WordPress, SMTP, SendGrid, Brevo, Freshmail, GetResponse. Voting without logging in using a confirmation code sent by e-mail. Surveys with a submissions page. Public or anonymous results, PDF export."

msgid "Zastąpić obecną treść wiadomości domyślną treścią?"
msgstr "Replace the current message content with the default content?"

msgid "Brak grup. Dodaj grupy w sekcji Grupy."
msgstr "No groups. Add groups in the Groups section."

msgid "Zapisz"
msgstr "Save"

msgid "Usunięto %d wiadomość."
msgid_plural "Usunięto %d wiadomości."
msgstr[0] "Deleted %d message."
msgstr[1] "Deleted %d messages."

msgid "Wybierz co najmniej jedną grupę docelową."
msgstr "Select at least one target group."

msgid "Nie można usunąć wiadomości w trakcie wysyłki. Poczekaj na zakończenie wysyłki."
msgstr "A message cannot be deleted while it is being sent. Wait for sending to finish."

msgid "Sekcje ekranu"
msgstr "Screen sections"

msgid "Wiadomości"
msgstr "Messages"

msgid "Dziennik zmian"
msgstr "Change log"

msgid "Lista grup"
msgstr "Group list"

msgid "Dodaj do grup"
msgstr "Add to groups"

msgid "Import CSV"
msgstr "CSV import"

msgid "Synchronizacja"
msgstr "Synchronization"

msgid "%d członek"
msgid_plural "%d członków"
msgstr[0] "%d member"
msgstr[1] "%d members"

msgid "Numer ID widoczny w Użytkownicy → Edytuj (w adresie strony: user_id=…). Nie znasz ID? Użyj zakładki „Dodaj do grup” i wyszukaj po adresie e-mail."
msgstr "The ID is shown in Users → Edit (in the page address: user_id=…). Don't know the ID? Use the “Add to groups” tab and search by e-mail address."

msgid "Następny »"
msgstr "Next »"

msgid "Dodaj członków do grup"
msgstr "Add members to groups"

msgid "Przytrzymaj Ctrl (Cmd na Mac), aby zaznaczyć wiele grup. Na telefonie dotknij kilku pozycji."
msgstr "Hold Ctrl (Cmd on Mac) to select multiple groups. On a phone, tap several items."

msgid "Dodaj członka po adresie e-mail"
msgstr "Add a member by e-mail address"

msgid "Wpisz fragment adresu e-mail (min. 2 znaki). Po opóźnieniu wyniki wyszukiwania pojawią się poniżej. Wybierz użytkownika i grupy, następnie kliknij „Dodaj\"."
msgstr "Type part of the e-mail address (min. 2 characters). After a short delay the search results will appear below. Select a user and groups, then click “Add”."

msgid "Przytrzymaj Ctrl (Cmd na Mac), aby zaznaczyć wiele grup."
msgstr "Hold Ctrl (Cmd on Mac) to select multiple groups."

msgid "Dodaj członków z pliku CSV"
msgstr "Add members from a CSV file"

msgid "Plik .csv lub .txt (maks. 2 MB) z adresami e-mail; pozostałe kolumny są ignorowane. Konta nie są tworzone — dodawani są tylko istniejący użytkownicy."
msgstr "A .csv or .txt file (max. 2 MB) with e-mail addresses; other columns are ignored. Accounts are not created — only existing users are added."

msgid "Przetworzono %1$d adresów: dodano %2$d, już w grupie %3$d, bez konta %4$d, niepoprawnych %5$d."
msgstr "Processed %1$d addresses: added %2$d, already in group %3$d, no account %4$d, invalid %5$d."

msgid "Odrzucone adresy"
msgstr "Rejected addresses"

msgid "Grupa"
msgstr "Group"

msgid "wybierz grupę"
msgstr "select a group"

msgid "Plik CSV"
msgstr "CSV file"

msgid "Dodać adresy z pliku do wybranej grupy?"
msgstr "Add the addresses from the file to the selected group?"

msgid "Importuj"
msgstr "Import"

msgid "Przykład: kolumna „email” z nagłówkiem albo same adresy, jeden w wierszu (separator: przecinek, średnik lub tabulator)."
msgstr "Example: an “email” column with a header, or just addresses, one per line (separator: comma, semicolon or tab)."

msgid "Synchronizacja grup"
msgstr "Group synchronization"

msgid "Odkrywa unikalne wartości pola \"miasto\" w bazie użytkowników, tworzy brakujące grupy i przypisuje do nich użytkowników automatycznie. Proces może trwać kilka minut przy kilku tysiącach użytkowników — nie zamykaj karty do końca. Synchronizacja uruchamiana jest automatycznie, według ustawień administratora."
msgstr "Discovers unique values of the \"city\" field in the user database, creates missing groups and assigns users to them automatically. The process may take several minutes with several thousand users — do not close the tab until it finishes. Synchronization runs automatically, according to the administrator's settings."

msgid "Szukam…"
msgstr "Searching…"

msgid "Brak wyników."
msgstr "No results."

msgid "Błąd wyszukiwania."
msgstr "Search error."

msgid "Legenda i tabela uprawnień"
msgstr "Legend and permissions table"

msgid "Wysyłka — masowa wysyłka wiadomości"
msgstr "Newsletter — mass message sending"

msgid "Legenda: nazewnictwo i uprawnienia"
msgstr "Legend: naming and permissions"

msgid "W dokumentach i na ekranie rola wtyczki zapisana w systemie jako poll_admin nazywana jest „Koordynator”."
msgstr "In documents and on screen, the plugin role stored in the system as poll_admin is called “Coordinator”."

msgid "Oznaczenia ról"
msgstr "Role labels"

msgid "Oznaczenie"
msgstr "Label"

msgid "Administrator"
msgstr "Administrator"

msgid "Rola WordPress: administrator. Pełny dostęp do wszystkiego, w tym Konfiguracja i nadawanie roli Koordynatora."
msgstr "WordPress role: administrator. Full access to everything, including Configuration and assigning the Coordinator role."

msgid "Rola wtyczki (poll_admin). Nadawana ręcznie przez Administratora lub innego Koordynatora. Dostęp do listy głosowań, ankiet, grup i koordynatorów; bez dostępu do Konfiguracji. Może dodawać i usuwać koordynatorów oraz grupy."
msgstr "Plugin role (poll_admin). Assigned manually by an Administrator or another Coordinator. Access to the list of polls, surveys, groups and coordinators; no access to Configuration. Can add and remove coordinators and groups."

msgid "Author / Editor"
msgstr "Author / Editor"

msgid "Role WordPress. Nie mają automatycznie roli Koordynatora; aby mogli zarządzać głosowaniami, należy nadać im rolę Koordynatora."
msgstr "WordPress roles. They do not automatically have the Coordinator role; to let them manage polls, grant them the Coordinator role."

msgid "Subskrybent"
msgstr "Subscriber"

msgid "Domyślna rola nowego użytkownika. Nie ma uprawnień Koordynatora; może tylko oddawać głosy, jeśli jest uprawniony."
msgstr "Default role of a new user. Has no Coordinator permissions; can only cast votes if eligible."

msgid "Tabela uprawnień"
msgstr "Permissions table"

msgid "Uprawnienie"
msgstr "Permission"

msgid "Pozostali (bez Koordynatora)"
msgstr "Others (without Coordinator)"

msgid "Lista głosowań, Ankiety, Grupy, Koordynatorzy"
msgstr "List of polls, Surveys, Groups, Coordinators"

msgid "Tak"
msgstr "Yes"

msgid "Nie"
msgstr "No"

msgid "Konfiguracja (mapowanie pól, e-mail itd.)"
msgstr "Configuration (field mapping, e-mail, etc.)"

msgid "Nadawanie i usuwanie roli Koordynatora"
msgstr "Granting and removing the Coordinator role"

msgid "Dodawanie i usuwanie grup"
msgstr "Adding and removing groups"

msgid "Start / Zakończ głosowanie, Zaproszenia"
msgstr "Start / End poll, Invitations"

msgid "Przejdź do menu OpenVote → Koordynatorzy."
msgstr "Go to the OpenVote → Coordinators menu."

msgid "Przejdź do menu OpenVote → Członkowie i grupy."
msgstr "Go to the OpenVote → Members and groups menu."

msgid "Są cztery sposoby (ekran Grupy ma zakładki: Lista grup, Dodaj do grup, Import CSV, Dodaj grupę, Synchronizacja, Dziennik zmian):"
msgstr "There are four ways (the Groups screen has tabs: Group list, Add to groups, CSV import, Add group, Synchronization, Change log):"

msgid "na ekranie Grupy, w zakładce „Dodaj do grup”, wyszukaj użytkownika po adresie e-mail, wybierz grupę (lub kilka) i kliknij „Dodaj do grup”."
msgstr "on the Groups screen, in the “Add to groups” tab, search for the user by e-mail address, select a group (or several) and click “Add to groups”."

msgid "Z pliku CSV"
msgstr "From a CSV file"

msgid "zakładka „Import CSV” (opis poniżej)."
msgstr "the “CSV import” tab (described below)."

msgid "Import z pliku CSV"
msgstr "Import from a CSV file"

msgid "Grupy → zakładka „Import CSV”: wybierz grupę, wskaż plik .csv lub .txt (maks. 2 MB) z adresami e-mail w kolumnie „email” (albo same adresy, jeden w wierszu; separator: przecinek, średnik lub tabulator; kodowanie Windows-1250 jest obsługiwane). Do grupy trafią tylko osoby, które już mają konto — konta nie są tworzone. Po imporcie zobaczysz raport: ile adresów dodano, ile już było w grupie, ile nie ma konta i ile jest niepoprawnych (z listą odrzuconych adresów)."
msgstr "Groups → “CSV import” tab: select a group, choose a .csv or .txt file (max. 2 MB) with e-mail addresses in the “email” column (or just addresses, one per line; separator: comma, semicolon or tab; Windows-1250 encoding is supported). Only people who already have an account are added to the group — accounts are not created. After the import you will see a report: how many addresses were added, how many were already in the group, how many have no account and how many are invalid (with a list of rejected addresses)."

msgid "Synchronizacja wszystkich grup-miast"
msgstr "Synchronizing all city groups"

msgid "Na stronie Członkowie i grupy w sekcji „Synchronizacja grup-miast” dostępne są dwa przyciski:"
msgstr "On the Members and groups page, in the “City group synchronization” section, there are two buttons:"

msgid "odkrywa unikalne wartości pola „miasto” w bazie użytkowników, tworzy brakujące grupy i przypisuje do nich użytkowników. Można wznawiać od ostatniego stanu (checkpoint) — przydatne przy bardzo dużej liczbie użytkowników."
msgstr "discovers unique values of the “city” field in the user database, creates missing groups and assigns users to them. It can be resumed from the last state (checkpoint) — useful with a very large number of users."

msgid "Synchronizuj od początku wszystkie grupy-miasta (Nie zalecane)"
msgstr "Synchronize all city groups from the beginning (Not recommended)"

msgid "robi to samo, ale resetuje zapisany stan i zaczyna synchronizację od zera. Użyj tylko wtedy, gdy np. zmieniła się struktura bazy użytkowników, lista miast lub chcesz wymusić pełne przeliczenie. Na co dzień korzystaj z pierwszego przycisku."
msgstr "does the same, but resets the saved state and starts synchronization from scratch. Use it only when, for example, the structure of the user database or the list of cities has changed, or you want to force a full recalculation. For everyday use, use the first button."

msgid "Proces może trwać bardzo długo przy dużej liczbie użytkowników. W logu widać postęp (partie miast, liczbę przetworzonych użytkowników)."
msgstr "The process may take a very long time with a large number of users. The log shows progress (city batches, number of users processed)."

msgid "Przejdź do OpenVote → Głosowania → Dodaj nowe."
msgstr "Go to OpenVote → Polls → Add new."

msgid "Wybierz z listy: 1h, 12h, 1 dzień, 7 dni, 14 dni, 21 dni, 28 dni. Data zakończenia jest obliczana automatycznie."
msgstr "Choose from the list: 1h, 12h, 1 day, 7 days, 14 days, 21 days, 28 days. The end date is calculated automatically."

msgid "Głosowanie bez logowania (kod z e-maila)"
msgstr "Voting without logging in (code from e-mail)"

msgid "Jeśli administrator włączy tę opcję (Konfiguracja → zakładka „Role i dostęp”, „Pozwól głosować bez logowania”), osoba niezalogowana może zagłosować po potwierdzeniu adresu e-mail:"
msgstr "If the administrator enables this option (Configuration → “Roles and access” tab, “Allow voting without logging in”), a person who is not logged in can vote after confirming their e-mail address:"

msgid "Uczestnik wpisuje adres e-mail powiązany z jego kontem na stronie głosowania."
msgstr "The participant enters the e-mail address linked to their account on the voting page."

msgid "Na ten adres wysyłany jest 4-cyfrowy kod. Kod jest ważny 15 minut, a ponowne wysłanie jest możliwe po 120 sekundach."
msgstr "A 4-digit code is sent to that address. The code is valid for 15 minutes, and it can be resent after 120 seconds."

msgid "Po wpisaniu poprawnego kodu uczestnik głosuje jako właściciel tego konta (z tymi samymi uprawnieniami i ograniczeniami grup co zalogowany)."
msgstr "After entering the correct code, the participant votes as the owner of that account (with the same permissions and group restrictions as a logged-in user)."

msgid "Zabezpieczenia: maksymalnie 5 prób na adres IP w ciągu 24 godzin (także dla adresu, którego nie znaleziono). Anonimowość głosu jest nadal egzekwowana po stronie serwera — kod potwierdza tylko tożsamość, nie ujawnia wyboru."
msgstr "Safeguards: at most 5 attempts per IP address within 24 hours (also for an address that was not found). Vote anonymity is still enforced server-side — the code only confirms identity and does not reveal the choice."

msgid "W panelu admina (OpenVote → kliknij głosowanie → Wyniki) dostępne są:"
msgstr "In the admin panel (OpenVote → click a poll → Results) the following are available:"

msgid "Limity wysyłki i automatyczne wznowienie"
msgstr "Sending limits and automatic resume"

msgid "W Konfiguracji w tabeli „Warunki wysyłki e-maili” można ustawić dla wybranej metody (Brevo darmowy, WordPress, SMTP) maksymalną liczbę e-maili: na 15 minut, na godzinę oraz na dobę. Wartość 0 oznacza brak limitu. Dla metod abonamentowych (SendGrid, Brevo płatny, Freshmail, GetResponse) limity czasowe nie są egzekwowane."
msgstr "In Configuration, in the “E-mail sending conditions” table, you can set for the selected method (Brevo free, WordPress, SMTP) the maximum number of e-mails: per 15 minutes, per hour and per day. A value of 0 means no limit. For subscription-based methods (SendGrid, Brevo paid, Freshmail, GetResponse) time limits are not enforced."

msgid "Gdy podczas wysyłki zaproszeń zostanie przekroczony ustawiony limit, wysyłka zatrzymuje się. Na ekranie Zaproszenia pojawia się komunikat z informacją, za ile minut można wznowić (dla limitów na 15 min i na godzinę). Przy przekroczeniu limitu dziennego dostępny jest przycisk „Zaplanuj automatyczne wznowienie” — po kliknięciu wysyłka zostanie automatycznie wznowiona o północy w strefie czasu głosowań (Konfiguracja → strefa czasowa)."
msgstr "When the set limit is exceeded while sending invitations, sending stops. The Invitations screen shows a message saying in how many minutes you can resume (for the 15-minute and hourly limits). When the daily limit is exceeded, a “Schedule automatic resume” button is available — after clicking it, sending will resume automatically at midnight in the polls' time zone (Configuration → time zone)."

msgid "Limity pomagają uniknąć zablokowania przez dostawcę poczty (np. Brevo free, WordPress) przy dużej liczbie odbiorców. Ustaw wartości zgodne z limitami Twojego planu. Do limitu wliczane są wyłącznie e-maile faktycznie dostarczone (zaakceptowane przez SMTP lub dostawcę); odrzucone próby wysyłki nie zwiększają licznika."
msgstr "Limits help avoid being blocked by the mail provider (e.g. Brevo free, WordPress) with a large number of recipients. Set values matching your plan's limits. Only e-mails actually delivered (accepted by SMTP or the provider) count toward the limit; rejected sending attempts do not increase the counter."

msgid "Automatyczne zaproszenia i cron serwera"
msgstr "Automatic invitations and server cron"

msgid "W formularzu głosowania pole „Automatycznie wyślij zaproszenia po rozpoczęciu głosowania” działa tylko wtedy, gdy na serwerze skonfigurowano cron. Cron to zadanie hostingu, które co 15 minut uruchamia plik PHP wtyczki z wiersza poleceń — dzięki temu wtyczka pracuje także wtedy, gdy nikt nie jest zalogowany."
msgstr "In the poll form, the “Automatically send invitations after the poll starts” field works only if cron is configured on the server. Cron is a hosting task that runs the plugin's PHP file from the command line every 15 minutes — thanks to this the plugin works even when nobody is logged in."

msgid "Co robi cron:"
msgstr "What cron does:"

msgid "Wysyła zaproszenia e-mail na trwające głosowania z zaznaczoną opcją automatycznej wysyłki. Dotyczy wyłącznie głosowań rozpoczętych po włączeniu tej funkcji i tylko jeśli dla głosowania nie wysłano jeszcze zaproszeń (ani automatycznie, ani ręcznie) — nikt nie dostanie zaproszenia dwa razy, a głosowania sprzed aktualizacji wtyczki nie są wysyłane automatycznie. Duże listy są wysyłane partiami w kolejnych wywołaniach, z poszanowaniem limitów wysyłki."
msgstr "Sends e-mail invitations for polls in progress that have the automatic sending option checked. It applies only to polls started after this feature was enabled and only if no invitations have yet been sent for the poll (neither automatically nor manually) — nobody will receive an invitation twice, and polls from before the plugin update are not sent automatically. Large lists are sent in batches in subsequent runs, respecting the sending limits."

msgid "Wznawia wysyłkę zaproszeń i wiadomości wstrzymaną przez limity (15 minut, godzina, doba), gdy limit znów na to pozwala — bez konieczności logowania."
msgstr "Resumes sending of invitations and messages halted by limits (15 minutes, hour, day) when the limit allows it again — without having to log in."

msgid "Wykonuje zaległe zadania harmonogramu wtyczki (np. automatyczną synchronizację grup)."
msgstr "Runs overdue plugin scheduler tasks (e.g. automatic group synchronization)."

msgid "Jak skonfigurować (cPanel):"
msgstr "How to configure (cPanel):"

msgid "Wejdź w Konfiguracja → zakładka „Cron” i skopiuj gotową komendę (przycisk „Kopiuj”)."
msgstr "Go to Configuration → “Cron” tab and copy the ready-made command (“Copy” button)."

msgid "W panelu hostingu (cPanel) otwórz „Zadania Cron” (Cron Jobs), w „Ustawieniach zwykłych” wybierz „Co 15 minut”."
msgstr "In the hosting panel (cPanel) open “Cron Jobs”, and under “Common Settings” choose “Every 15 minutes”."

msgid "W polu „Polecenie” wklej komendę z zakładki Cron (zaczyna się od „/usr/local/bin/php -q”). Jeśli PHP jest na serwerze w innym miejscu, zamień ścieżkę (np. na /usr/bin/php). Nie są potrzebne ani wget, ani curl, ani żaden klucz. Każde uruchomienie dopisuje do pliku cron/cron-log.php w katalogu wtyczki datę, wersję PHP i wynik — po pierwszym uruchomieniu sprawdź ten plik przez FTP. Wtyczka wymaga PHP 8.1 lub nowszego; przy starszej wersji cron tylko zapisze błąd w logu."
msgstr "In the “Command” field paste the command from the Cron tab (it starts with “/usr/local/bin/php -q”). If PHP is located elsewhere on the server, replace the path (e.g. with /usr/bin/php). Neither wget, curl nor any key is needed. Each run appends the date, PHP version and result to the cron/cron-log.php file in the plugin directory — after the first run, check this file via FTP. The plugin requires PHP 8.1 or newer; with an older version cron will only write an error to the log."

msgid "Po kilkunastu minutach zakładka „Cron” pokaże zielony znacznik „Działa”. Przycisk „Uruchom teraz” pozwala sprawdzić działanie od ręki."
msgstr "After a dozen or so minutes the “Cron” tab will show a green “Working” marker. The “Run now” button lets you check it right away."

msgid "Katalog „cron” wtyczki jest zablokowany dla przeglądarek plikiem .htaccess, a skrypt uruchamia się wyłącznie z wiersza poleceń. Bez crona zaproszenia nadal można wysłać ręcznie z ekranu Zaproszenia."
msgstr "The plugin's “cron” directory is blocked from browsers by an .htaccess file, and the script runs only from the command line. Without cron, invitations can still be sent manually from the Invitations screen."

msgid "Moduł Wysyłka (menu OpenVote → Wysyłka) umożliwia tworzenie i wysyłkę masowych wiadomości e-mail do wybranych grup użytkowników — niezależnie od głosowań. Przydatne do ogłoszeń, powiadomień lub newslettera."
msgstr "The Newsletter module (OpenVote → Newsletter menu) lets you create and send mass e-mail messages to selected user groups — independently of polls. Useful for announcements, notifications or a newsletter."

msgid "Tworzenie i wysyłka"
msgstr "Creating and sending"

msgid "Wpisz tytuł wysyłki i treść wiadomości w sekcji \"Nowa wysyłka\" (lub edytuj istniejącą w pozycji \"Edytuj\" na liście)."
msgstr "Enter the newsletter title and message content in the \"New newsletter\" section (or edit an existing one using \"Edit\" in the list)."

msgid "Wybierz co najmniej jedną grupę docelową (Ctrl lub Cmd + klik dla wielu). Tylko członkowie tych grup otrzymają wiadomość."
msgstr "Select at least one target group (Ctrl or Cmd + click for multiple). Only members of these groups will receive the message."

msgid "Kliknij \"Zapisz\", a następnie \"Wyślij\" przy danej wiadomości — otworzy się ekran wysyłki z podglądem i przyciskiem \"Wyślij wiadomości e-mailem\"."
msgstr "Click \"Save\", then \"Send\" next to the message — the sending screen opens with a preview and the \"Send messages by e-mail\" button."

msgid "Wysyłka odbywa się partiami (jak zaproszenia). Postęp i ewentualne błędy są widoczne na ekranie."
msgstr "Sending is done in batches (like invitations). Progress and any errors are shown on the screen."

msgid "Kody w treści wiadomości"
msgstr "Codes in the message content"

msgid "W treści i temacie możesz użyć kodów zastępowanych przy wysyłce:"
msgstr "In the content and subject you can use codes that are replaced when sending:"

msgid "imię i nazwisko autora wiadomości"
msgstr "full name of the message author"

msgid "skrót organizacji z Konfiguracji"
msgstr "organization abbreviation from Configuration"

msgid "nazwa grupy odbiorcy (z wybranych grup docelowych)"
msgstr "name of the recipient's group (from the selected target groups)"

msgid "lista wszystkich grup docelowych wysyłki"
msgstr "list of all target groups of the newsletter"

msgid "Statusy i akcje na liście"
msgstr "Statuses and actions in the list"

msgid "wiadomość nie została jeszcze wysłana. Dostępne: Edytuj, Duplikuj, Usuń, Wyślij."
msgstr "the message has not been sent yet. Available: Edit, Duplicate, Delete, Send."

msgid "wiadomość została wysłana. Dostępne: Podgląd (wyszarzony widok bez edycji), Duplikuj, Usuń. Link \"Wyślij\" nie jest wyświetlany."
msgstr "the message has been sent. Available: Preview (greyed-out view without editing), Duplicate, Delete. The \"Send\" link is not displayed."

msgid "Wysłanej wiadomości nie można już edytować; można ją zduplikować i edytować kopię."
msgstr "A sent message can no longer be edited; you can duplicate it and edit the copy."

msgid "Limity i statystyki"
msgstr "Limits and statistics"

msgid "Te same limity co dla zaproszeń (na 15 min, godzinę, dobę) dotyczą wysyłki z modułu Wysyłka. Do limitu i statystyk \"Liczba wysłanych e-maili\" wliczane są tylko e-maile faktycznie dostarczone do serwera SMTP lub dostawcy; odrzucone adresy (np. nieaktywne) nie zwiększają licznika."
msgstr "The same limits as for invitations (per 15 min, hour, day) apply to sending from the Newsletter module. Only e-mails actually delivered to the SMTP server or provider count toward the limit and the \"Number of e-mails sent\" statistics; rejected addresses (e.g. inactive) do not increase the counter."

msgid "Dostępna w menu OpenVote → Konfiguracja (tylko Administrator WordPress). Ekran ma zakładki: Ogólne, Pola użytkownika, Role i dostęp, Wysyłka e-mail, Szablon zaproszenia, Auto-synchronizacja, Nieaktywni, Narzędzia."
msgstr "Available in the OpenVote → Configuration menu (WordPress Administrator only). The screen has tabs: General, User fields, Roles and access, E-mail sending, Invitation template, Auto-synchronization, Inactive, Tools."

msgid "Slug strony z ankietami (np. \"ankieta\"). Strona powinna zawierać blok \"Ankiety (Open Vote)\". Przyciski \"Utwórz stronę ankiet\" i \"Zaktualizuj stronę ankiet (dodaj blok)\" tworzą lub uzupełniają stronę."
msgstr "Slug of the page with surveys (e.g. \"survey\"). The page should contain the \"Surveys (Open Vote)\" block. The \"Create surveys page\" and \"Update surveys page (add block)\" buttons create or complete the page."

msgid "Slug strony ze zgłoszeniami ankiet oznaczonymi jako „Nie spam\" (np. \"zgloszenia\"). Strona zawiera blok \"Zgłoszenia (Open Vote)\". Na stronie publicznej wyświetlane są tylko imię i nazwisko oraz odpowiedzi na pytania — wartości pól uznanych za wrażliwe (E-mail, Miasto, Telefon, PESEL itd.) są ukrywane. Przyciski \"Utwórz stronę zgłoszeń\" i \"Zaktualizuj stronę zgłoszeń (dodaj blok)\" ułatwiają konfigurację."
msgstr "Slug of the page with survey submissions marked as \"Not spam\" (e.g. \"submissions\"). The page contains the \"Submissions (Open Vote)\" block. The public page shows only the first and last name and the answers to questions — values of fields considered sensitive (E-mail, City, Phone, national ID number, etc.) are hidden. The \"Create submissions page\" and \"Update submissions page (add block)\" buttons make configuration easier."

msgid "WordPress (wp_mail), SMTP zewnętrzny, SendGrid API, Brevo (darmowy i płatny), Freshmail API, GetResponse API. Wybór dotyczy zarówno zaproszeń do głosowań, jak i wysyłki z modułu Wysyłka."
msgstr "WordPress (wp_mail), external SMTP, SendGrid API, Brevo (free and paid), Freshmail API, GetResponse API. The choice applies both to poll invitations and to sending from the Newsletter module."

msgid "Warunki wysyłki e-maili"
msgstr "E-mail sending conditions"

msgid "Dla Brevo darmowy, WordPress i SMTP: maks. liczba e-maili na 15 min, na godzinę i na dobę. Po przekroczeniu limitu wysyłka zatrzymuje się; przy limitcie dziennym można zaplanować automatyczne wznowienie o północy. Wartość 0 = brak limitu."
msgstr "For Brevo free, WordPress and SMTP: max. number of e-mails per 15 min, per hour and per day. After the limit is exceeded, sending stops; with the daily limit you can schedule an automatic resume at midnight. Value 0 = no limit."

msgid "Domyślnie: wbudowane pole „Przyjazna dla URL wersja nazwy” (user_nicename) z wp_users. Pseudonim w anonimowych wynikach. Zawsze wymagane."
msgstr "Default: the built-in “URL-friendly version of the name” field (user_nicename) from wp_users. Pseudonym in anonymous results. Always required."

msgid "Dane własne"
msgstr "Custom data"

msgid "Opcjonalne. Dowolne pole z profilu (np. numer dowodu). Można zaznaczyć jako wymagane do głosowania."
msgstr "Optional. Any profile field (e.g. ID card number). Can be marked as required for voting."

msgid "Na publicznej stronie zgłoszeń (/zgloszenia lub inny skonfigurowany slug) wtyczka nie wyświetla wartości pól uznanych za wrażliwe. Są to pola z listy mapowania: E-mail, Grupa, Numer telefonu, Dane własne. Aby dana odpowiedź w ankiecie była na stronie zgłoszeń ukryta (pokazywane jest „—\"), przy tworzeniu lub edycji ankiety zaznacz checkbox „Informacja wrażliwa - nie pokazuj odpowiedzi na stronie publicznie\" przy tym pytaniu."
msgstr "On the public submissions page (/zgloszenia or another configured slug) the plugin does not display values of fields considered sensitive. These are fields from the mapping list: E-mail, Group, Phone number, Custom data. To hide a given survey answer on the submissions page (“—” is shown), when creating or editing the survey check the “Sensitive information - do not show the answer on the public page” checkbox for that question."

msgid "Przykład: jeśli zaznaczysz pole opcjonalne (np. Telefon) jako wymagane do głosowania, ale klucz pozostanie \"nie określone\", żaden użytkownik nie będzie mógł głosować (pole zawsze puste). Najpierw ustaw poprawny klucz meta, dopiero potem zaznacz jako wymagane."
msgstr "Example: if you mark an optional field (e.g. Phone) as required for voting but the key remains \"not specified\", no user will be able to vote (the field is always empty). First set the correct meta key, and only then mark it as required."

msgid "Lista ankiet: OpenVote → Ankiety (lub z menu listy głosowań — opcja \"Ankiety\")."
msgstr "Survey list: OpenVote → Surveys (or from the poll list menu — the \"Surveys\" option)."

msgid "Na górze listy ankiet wyświetlane jest okienko z adresami strony ankiet i strony zgłoszeń (linki do wypełniania ankiet i przeglądania zgłoszeń). Okienko można zamknąć krzyżykiem; stan zamknięcia jest zapamiętany do końca sesji przeglądarki."
msgstr "At the top of the survey list a box is displayed with the addresses of the surveys page and the submissions page (links for filling in surveys and browsing submissions). The box can be closed with the cross; the closed state is remembered until the end of the browser session."

msgid "Tworzenie i edycja: tytuł, opis, czas trwania, pola ankiety (etykieta, typ pola, opcjonalnie checkbox informacja wrażliwa)."
msgstr "Creating and editing: title, description, duration, survey fields (label, field type, optionally the sensitive information checkbox)."

msgid "Informacja wrażliwa przy polach ankiety"
msgstr "Sensitive information in survey fields"

msgid "Przy każdym polu ankiety (pytaniu) znajduje się checkbox „Informacja wrażliwa - nie pokazuj odpowiedzi na stronie publicznie”. Domyślnie jest odznaczony."
msgstr "Each survey field (question) has the checkbox “Sensitive information - do not show the answer on the public page”. It is unchecked by default."

msgid "Gdy checkbox jest odznaczony, odpowiedź użytkownika na to pytanie jest na stronie zgłoszeń (/zgloszenia) wyświetlana w całości."
msgstr "When the checkbox is unchecked, the user's answer to this question is displayed in full on the submissions page (/zgloszenia)."

msgid "Gdy checkbox jest zaznaczony, wartość tej odpowiedzi na stronie zgłoszeń zostanie zastąpiona znakiem „—\", aby nie ujawniać danych publicznie."
msgstr "When the checkbox is checked, the value of this answer on the submissions page will be replaced with the “—” character so as not to disclose data publicly."

msgid "Adres strony (slug) ustawiasz w Konfiguracji w sekcji „URL strony zgłoszeń\". Strona powinna zawierać blok Gutenberg „Zgłoszenia (Open Vote)\" (openvote/survey-responses). Możesz utworzyć ją ręcznie w edytorze lub użyć przycisków w Konfiguracji: „Utwórz stronę zgłoszeń\" lub „Zaktualizuj stronę zgłoszeń (dodaj blok)\"."
msgstr "You set the page address (slug) in Configuration, in the “Submissions page URL” section. The page should contain the Gutenberg block “Submissions (Open Vote)” (openvote/survey-responses). You can create it manually in the editor or use the buttons in Configuration: “Create submissions page” or “Update submissions page (add block)”."

msgid "Na stronie wyświetlane są tylko zgłoszenia ze statusem „Nie spam\". Dla każdego zgłoszenia widać: tytuł ankiety, imię i nazwisko oraz listę pytań z odpowiedziami. Odpowiedzi oznakowane w ankiecie jako informacja wrażliwa są ukrywane („—\")."
msgstr "Only submissions with the status “Not spam” are displayed on the page. For each submission you can see: the survey title, first and last name, and a list of questions with answers. Answers marked in the survey as sensitive information are hidden (“—”)."

msgid "Osobna opcja w Konfiguracji to „URL strony ankiet\" — strona z blokiem „Ankiety (Open Vote)\", na której użytkownicy wypełniają ankiety. Slug możesz ustawić np. na \"ankieta\"."
msgstr "A separate option in Configuration is the “Surveys page URL” — a page with the “Surveys (Open Vote)” block where users fill in surveys. You can set the slug to e.g. \"survey\"."

msgid "Wysyłka zaproszeń zatrzymała się z komunikatem o limicie."
msgstr "Sending invitations stopped with a limit message."

msgid "Wtyczka respektuje limity ustawione w Konfiguracji (Warunki wysyłki e-maili). Poczekaj do czasu podanego w komunikacie (np. „Wznowienie za X min”) lub przy limitcie dziennym kliknij „Zaplanuj automatyczne wznowienie” — wysyłka zostanie wznowiona o północy. Możesz też zwiększyć limity w Konfiguracji, jeśli dostawca poczty na to pozwala."
msgstr "The plugin respects the limits set in Configuration (E-mail sending conditions). Wait until the time given in the message (e.g. “Resume in X min”) or, with the daily limit, click “Schedule automatic resume” — sending will resume at midnight. You can also raise the limits in Configuration if your mail provider allows it."

msgid "(Brak treści)"
msgstr "(No content)"

msgid "Wysłać „%1$s” do %2$d odbiorców? Tej operacji nie można cofnąć."
msgstr "Send “%1$s” to %2$d recipients? This operation cannot be undone."

msgid "Skrypt wysyłki niedostępny."
msgstr "Sending script unavailable."

msgid "Pominięto użytkowników nieaktywnych. Wysyłka liczy 0 osób."
msgstr "Inactive users were skipped. Sending covers 0 people."

msgid "Wysłano. Odświeżam stronę…"
msgstr "Sent. Refreshing the page…"

msgid "12h"
msgstr "12h"

msgid "28 dni"
msgstr "28 days"

msgid "Głosowanie wystartowało. Data rozpoczęcia ustawiona na dziś."
msgstr "The poll has started. The start date was set to today."

msgid "Od momentu startu głosowania. Możesz wydłużyć trwające głosowanie (nowy termin musi być w przyszłości)."
msgstr "From the moment the poll starts. You can extend a poll in progress (the new end date must be in the future)."

msgid "Ctrl+klik wybiera wiele grup. Do startu głosowania zaznacz co najmniej jedną grupę."
msgstr "Ctrl+click selects multiple groups. Select at least one group before starting the poll."

msgid "Automatycznie wyślij zaproszenia po rozpoczęciu głosowania (wymaga skonfigurowanego crona)"
msgstr "Automatically send invitations after the poll starts (requires cron to be configured)"

msgid "Zaznaczone domyślnie. Zaproszenia wyśle automatycznie cron serwera (Konfiguracja → Cron), najpóźniej do 15 minut po starcie, tylko jeśli dla tego głosowania nie wysłano wcześniej zaproszeń. Bez crona użyj ekranu Zaproszenia."
msgstr "Checked by default. Invitations will be sent automatically by the server cron (Configuration → Cron), at the latest within 15 minutes after the start, only if no invitations have previously been sent for this poll. Without cron, use the Invitations screen."

msgid "1–24 pytania; każde: min. 2 własne odpowiedzi + „Wstrzymuję się”, razem 3–12"
msgstr "1–24 questions; each: min. 2 own answers + “Abstain”, 3–12 in total"

msgid "Usuń pytanie %d"
msgstr "Remove question %d"

msgid "Aby zagłosować, należy wejść na stronę %s (zgodnie z ustawieniami w Konfiguracji)."
msgstr "To vote, go to the page %s (according to the settings in Configuration)."

msgid "Głosowanie dobiegło końca (minął termin zakończenia) — wysyłka zaproszeń nie ma już sensu."
msgstr "The poll has ended (the end date has passed) — sending invitations no longer makes sense."

msgid "Wysyłka zaproszeń jest możliwa tylko podczas trwania głosowania."
msgstr "Sending invitations is possible only while the poll is in progress."

msgid "— wysyłka jest już niedostępna (głosowanie nie trwa)"
msgstr "— sending is no longer available (the poll is not in progress)"

msgid "Przetworzono"
msgstr "Processed"

msgid "Zakończono. Możesz skopiować log poniżej. Gdy skończysz, kliknij „Odśwież stronę”."
msgstr "Finished. You can copy the log below. When done, click “Refresh page”."

msgid "Odśwież stronę"
msgstr "Refresh page"

msgid "Wysłać zaproszenia do %d osób? Tej operacji nie można cofnąć."
msgstr "Send invitations to %d people? This operation cannot be undone."

msgid "Odpowiedź serwera:"
msgstr "Server response:"

msgid "Zaproszenia (wysyłka)"
msgstr "Invitations (sending)"

msgid "Wyniki cząstkowe."
msgstr "Partial results."

msgid "Termin zakończenia minął, ale głosowanie nie zostało jeszcze formalnie zakończone (kliknij „Zakończ” na liście głosowań). Wyniki mogą się jeszcze zmienić."
msgstr "The end date has passed, but the poll has not yet been formally ended (click “End” in the poll list). Results may still change."

msgid "Głosowanie trwa — poniższe liczby mogą się jeszcze zmienić. Wyniki ostateczne będą po zakończeniu."
msgstr "The poll is in progress — the numbers below may still change. Final results will be available after it ends."

msgid "To jest szkic — głosowanie jeszcze nie wystartowało, więc nie ma wyników."
msgstr "This is a draft — the poll has not started yet, so there are no results."

msgid "(wliczając brak głosu)"
msgstr "(including no vote)"

msgid "Razem głosów"
msgstr "Total votes"

msgid "Odłącz od grupy"
msgstr "Remove from group"

msgid "Odłączyć użytkownika %1$s od grupy „%2$s”?"
msgstr "Remove user %1$s from group “%2$s”?"

msgid "Odebrać rolę Koordynatora użytkownikowi %s i odłączyć go od wszystkich grup?"
msgstr "Revoke the Coordinator role from user %s and remove them from all groups?"

msgid "Odbierz rolę koordynatora"
msgstr "Revoke coordinator role"

msgid "Dziennik zmian koordynatorów"
msgstr "Coordinator change log"

msgid "Dodano pole „user_gsm” do profilu i zmapowano je na Numer telefonu. Użytkownicy mogą uzupełnić telefon w swoim profilu."
msgstr "The “user_gsm” field was added to the profile and mapped to Phone number. Users can fill in their phone number in their profile."

msgid "Dodano pole „user_group” do profilu, zmapowano na Grupa i ustawiono jako wymagane do głosowania. Użytkownicy mogą uzupełnić grupę w swoim profilu; następnie uruchom synchronizację grup."
msgstr "The “user_group” field was added to the profile, mapped to Group and set as required for voting. Users can fill in their group in their profile; then run group synchronization."

msgid "Jeśli po wejściu na adres strony widzisz „Not Found”: wejdź w Ustawienia → Bezpośrednie odnośniki, wybierz dowolną strukturę inną niż „Zwykły” i kliknij „Zapisz zmiany”."
msgstr "If you see “Not Found” after opening the page address: go to Settings → Permalinks, choose any structure other than “Plain” and click “Save Changes”."

msgid "Sprawdź konfigurację"
msgstr "Check configuration"

msgid "Sekcje konfiguracji"
msgstr "Configuration sections"

msgid "Ogólne"
msgstr "General"

msgid "Pola użytkownika"
msgstr "User fields"

msgid "Role i dostęp"
msgstr "Roles and access"

msgid "Wysyłka e-mail"
msgstr "E-mail sending"

msgid "Szablon zaproszenia"
msgstr "Invitation template"

msgid "Auto-synchronizacja"
msgstr "Auto-synchronization"

