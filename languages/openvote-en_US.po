msgstr "Cron runs the synchronization process at 00:00 in the WordPress time zone (on Sundays according to the selected schedule)."

msgid "Harmonogram"
msgstr "Schedule"

msgid "Tylko ręcznie"
msgstr "Manually only"

msgid "Automatycznie w pierwszą niedzielę miesiąca"
msgstr "Automatically on the first Sunday of the month"

msgid "Automatycznie co drugą niedzielę miesiąca"
msgstr "Automatically every second Sunday of the month"

msgid "Automatycznie co niedzielę"
msgstr "Automatically every Sunday"

msgid "Automatycznie codziennie (Nie zalecane przy dużej ilości użytkowników)"
msgstr "Automatically every day (Not recommended with a large number of users)"

